{
  "name": "n8n-nodes-github-app",
  "version": "1.0.0",
  "description": "n8n node for GitHub with GitHub App authentication",
  "license": "MIT",
  "homepage": "https://github.com/galsalo/n8n-custom-nodes",
  "author": "galsalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/galsalo/n8n-custom-nodes.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build",
    "dev": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "github",
    "github-app"
  ],
  "n8n": {
