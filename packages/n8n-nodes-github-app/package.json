    "nodes": [
      "dist/nodes/GithubApp/GithubApp.node.js"
    ]
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.2.2"
  }
}
